{
  "name": "@sting8k/pi-geek-tui",
  "version": "0.2.1",
  "description": "Geek terminal UI for Pi: continuous rail, one-row tool calls in collapsible groups, box-less input zone, one-row statusline.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "*.ts",
    "core/",
    "editor/",
    "messages/",
    "performance/",
    "presentation/",
    "theme/",
    "tool-tags/",
    "widgets/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "pi-geek-tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sting8k/pi-geek-tui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:link": "npm install",
    "dev:clean": "rm -rf node_modules",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --noImplicitAny false index.ts",
    "test": "npm run test:working-message && npm run test:geek-frame && npm run test:tasks-widget-compact && npm run test:collapsed-thinking && npm run test:presentation-buffer && npm run test:reveal && npm run test:session-resume-styling && npm run test:tui-proxy && npm run test:builtin-tool-renderers && npm run test:geek-rows && npm run test:geek-conversation && npm run test:content-runs && npm run test:git-diff-stat && npm run test:slash-menu && npm run test:geek-shimmer && npm run test:geek-footer && npm run test:geek-head-diff && npm run test:geek-slash-editor && npm run test:geek-slot-frame && npm run test:statusline && npm run test:image-attachments",
    "check": "npm run typecheck && npm test && npm pack --dry-run",
    "profile:render": "node scripts/render-profile-bench.mjs",
    "trace:pi": "node scripts/pi-trace.mjs",
    "debug:render-log": "node scripts/render-frame-log-summary.mjs",
    "test:working-message": "node scripts/working-message-config-smoke.mjs",
    "test:tasks-widget-compact": "node scripts/tasks-widget-compact-smoke.mjs",
    "test:collapsed-thinking": "node scripts/collapsed-thinking-smoke.mjs",
    "test:presentation-buffer": "node scripts/presentation-buffer-smoke.mjs",
    "test:reveal": "node scripts/reveal-smoke.mjs",
    "test:session-resume-styling": "node scripts/session-resume-styling-smoke.mjs",
    "test:tui-proxy": "node scripts/tui-proxy-recursion-smoke.mjs",
    "test:builtin-tool-renderers": "node scripts/builtin-tool-renderers-smoke.mjs",
    "test:geek-rows": "node scripts/geek-rows-smoke.mjs",
    "test:geek-frame": "node scripts/geek-frame-smoke.mjs",
    "test:geek-conversation": "node scripts/geek-conversation-smoke.mjs",
    "test:content-runs": "node scripts/content-runs-smoke.mjs",
    "test:git-diff-stat": "node scripts/git-diff-stat-smoke.mjs",
    "test:slash-menu": "node scripts/slash-menu-smoke.mjs",
    "test:geek-shimmer": "node scripts/geek-shimmer-smoke.mjs",
    "test:geek-footer": "node scripts/geek-footer-smoke.mjs",
    "test:geek-head-diff": "node scripts/geek-head-diff-smoke.mjs",
    "test:geek-slash-editor": "node scripts/geek-slash-editor-smoke.mjs",
    "test:geek-slot-frame": "node scripts/geek-slot-frame-smoke.mjs",
    "test:statusline": "node scripts/statusline-smoke.mjs",
    "test:image-attachments": "node scripts/image-attachments-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/sting8k/pi-geek-tui/main/screenshots/image.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "@earendil-works/pi-tui": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
